# Copy to .env and fill in to move from mock/stubbed integrations to live ones.
# Every integration below auto-detects its keys at startup: set them and the
# pipeline calls the real API; leave them blank and it transparently falls
# back to deterministic mock data/logging, with zero code changes required.
# A failed live call (bad key, rate limit, outage) also falls back to the
# mock for that lead rather than breaking the run.

# Where leads/alerts persist. One SQLite file, but data is scoped per
# tenant -- a single self-hosted buyer needs nothing else here. To run one
# shared instance for multiple customers instead, provision each one with
# `cd backend && python scripts/create_tenant.py "Customer Name"`; they
# authenticate with the printed API key, everyone else (no key) still gets
# the zero-config default tenant.
DATABASE_PATH=data/app.db
# Optional: set to a postgres:// or postgresql:// URL to run against
# Postgres instead of the SQLite file above (DATABASE_PATH is then ignored
# entirely) -- useful for a seller's multi-tenant deployment that wants real
# concurrent-write support. Leave unset for the zero-config SQLite default.
# Requires the psycopg2-binary dependency in requirements.txt (always
# listed, only actually imported when this is set). Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/crm_scoring
DATABASE_URL=

# "text" (human-readable, local dev) or "json" (one JSON object per stdout
# line, for log aggregators when this runs in a container).
LOG_FORMAT=text

# Real Claude LLM scoring + outreach drafting (falls back to a mock assessment if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Firmographic enrichment via Apollo.io organization-enrichment API
APOLLO_API_KEY=

# CRM push — Salesforce's custom Lead fields (fit_score, combined_score,
# lead_bucket, llm_rationale, outreach_draft) are best-effort auto-created
# via the Tooling API (needs "Customize Application" on the API user); see
# services/crm.py header for the fallback behavior if that permission is missing.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# Slack alerts — posts to SLACK_CHANNEL_ID via slack_sdk when both are set.
# Needs the chat:write scope, and the bot must be invited to the channel
# (/invite @<bot-name> in Slack) — a preflight check logs a clear warning
# on first alert if either is missing, instead of a generic API error.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Frontend origin(s) allowed to call this API, comma-separated. Defaults to
# the local Vite dev server — a production deploy MUST set this to its real
# frontend origin(s) or the browser will block every request.
CORS_ALLOWED_ORIGINS=http://localhost:5000

# --- Security (app/middleware.py, app/main.py) ---
# Redirects plain HTTP to HTTPS at the app level. Leave false for local dev
# and for deployments where a proxy already does this (Render does) —
# only turn on for a self-hosted deployment terminating its own TLS with
# no proxy in front handling the redirect.
FORCE_HTTPS=false
# Trusts X-Forwarded-For/X-Forwarded-Proto from the immediate connecting
# peer, so rate limiting and HTTPS-detection see the real client
# IP/scheme instead of a reverse proxy's. Only enable this when you
# control what's in front of this process (a known, trusted managed-host
# proxy) — an internet-facing instance with this on and no real proxy in
# front lets any client spoof their own IP/scheme via those headers, defeating rate
# limiting entirely. Also flips on uvicorn's --proxy-headers in
# run-prod.sh/Dockerfile.
TRUST_PROXY_HEADERS=false
# Per-route rate limits (slowapi/limits syntax: "<count>/<second|minute|hour|day>").
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_UPLOAD=10/minute
# Tighter still for signup/login/forgot-password (routers/accounts.py) --
# classic brute-force/enumeration/spam targets.
RATE_LIMIT_AUTH=5/minute
# Upload caps, enforced before parsing (routers/leads.py, routers/churn.py).
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_ROWS=50000

# --- Self-serve tenant signup (routers/accounts.py) ---
# An alternative to running scripts/create_tenant.py by hand -- a buyer can
# sign up with email+password and get their own workspace automatically.
# Only relevant if you're running one shared instance for multiple
# customers; a single self-hosted buyer never needs this.
# Must be wherever the frontend actually runs (the Vite dev server locally,
# your real domain in production) -- used to build the link in a
# password-reset email.
APP_BASE_URL=http://localhost:5000
PASSWORD_RESET_TTL_MINUTES=30

# --- Licensing (buyer side — set these in a deployment you SELL/self-host) ---
# Issued after purchase (see licensing/README.md). Verified offline.
LICENSE_KEY=
LICENSE_PUBLIC_KEY=
# When true, /api/leads/upload 402s immediately without a valid Pro/Advanced
# LICENSE_KEY, disabling the free Starter tier below entirely. Leave false
# (default) to give a fresh deployment Starter's permanent free allowance.
LICENSE_REQUIRED=false
# How many total uploads the free Starter tier (no Pro/Advanced LICENSE_KEY)
# gets before it starts 402ing. No time limit -- this lifetime cap is
# Starter's only gate, persisted to the same SQLite file as everything else
# (survives restarts).
TRIAL_MAX_UPLOADS=10
# Caps each upload to at most this many rows on the Starter tier, so a
# prospect can judge scoring quality on a real sample without full free
# use of a large list. No cap on Pro/Advanced.
TRIAL_MAX_LEADS_PER_UPLOAD=10

# Seller's public hosted app only (crmscoring.com's "Get started free").
# true = every visitor gets a private free-trial workspace (10 uploads x 10
# rows), requests without a workspace key are refused, and the default
# workspace/LICENSE_KEY are never exposed. Leave false for self-hosted installs.
HOSTED_MODE=false
# Per-IP limit on starting free trials (hosted mode only).
RATE_LIMIT_TRIAL=3/hour

# --- Licensing & billing (seller side — only the seller's storefront needs these) ---
# Subscriptions through Paying (our self-hosted payment service on Armenian
# providers: ArCa cards, Ameriabank, Idram) — Pro and Advanced each bill
# monthly or annually (Starter is free). Each paid period issues a fresh
# expiring license key. See licensing/README.md for setup.
LICENSE_PRIVATE_KEY=
# Address of the Paying server, e.g. https://pay.crmscoring.com
PAYING_URL=
# Printed by `python -m paying.cli create-app` on the Paying server.
# sk_test_... from a sandbox server (no real charges), sk_live_... from a
# live one. Never commit a real key.
PAYING_SECRET_KEY=
# Webhook secret (whsec_...) printed alongside it. Register the webhook URL
# https://<backend>/api/billing/webhook when creating the app.
PAYING_WEBHOOK_SECRET=
BILLING_CURRENCY=USD
# Decimal amounts in BILLING_CURRENCY, sent with each checkout. Advanced is functionally identical to Pro
# today — priced higher for agency framing.
PRICE_PRO_MONTHLY=20.00
PRICE_PRO_ANNUAL=192.00
PRICE_ADVANCED_MONTHLY=40.00
PRICE_ADVANCED_ANNUAL=384.00
# Public marketing site (docs/).
STOREFRONT_URL=https://crmscoring.com
# Licenses expire this many days out — bounds how long a cancelled
# subscriber's key keeps working, since an offline key can't be revoked.
# Every renewal issues a fresh key.
LICENSE_VALIDITY_DAYS_MONTHLY=35
LICENSE_VALIDITY_DAYS_ANNUAL=380

# Polar — a second, independent merchant-of-record processor, not a
# fallback for Paddle. Added for sellers Paddle can't serve either: Polar
# pays out via Stripe Connect Express, whose supported *recipient*
# countries are broader than the countries Stripe supports for a direct
# merchant account. Leave unset to keep the Polar buttons hidden entirely
# licensing/README.md for full setup.
# Polar models each plan as its own Product (not one product with multiple
# Prices, as Paddle does) — create two Products in the Polar dashboard, one
# per plan, and put their ids here.

# Emails issued license keys to buyers automatically. Without either of
# these set, keys are still issued and logged to
# licensing/issued_licenses.jsonl — send them by hand instead. SendGrid is
# tried first if configured, SMTP is the fallback.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
